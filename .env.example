# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production
# Public URL used in WhatsApp links (manage / check-in pages)
SITE_URL=https://tailbonetreatment.com
# Clinic WhatsApp number, digits only with country code
WHATSAPP_NUMBER=919886688323
# First admin account (created on first start only)
ADMIN_EMAIL=rajveer.pt@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: fixed secret for sign-in cookies (otherwise generated into data/)
SESSION_SECRET=
# Where the SQLite database lives; mount a persistent disk here in production
DATA_DIR=data

# --- Security ---
# 32-byte key for encrypting clinical notes. Generate once and KEEP A BACKUP: lost key = unreadable notes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Payments (Razorpay) — leave empty to use "pay at clinic" ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<site>/api/payments/webhook, events: payment.captured, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# --- Automatic WhatsApp (Meta WhatsApp Cloud API) — empty = one-tap manual sending from the dashboard ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with a single body variable {{1}}
WHATSAPP_TEMPLATE=clinic_update
WHATSAPP_TEMPLATE_LANG=en
# Also message the doctor on WhatsApp about patient changes (digits with country code)
DOCTOR_WHATSAPP=

# --- Email the doctor about patient changes (Resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Tailbone Clinic <noreply@tailbonetreatment.com>
DOCTOR_EMAIL=
